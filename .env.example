# Set one provider key and its matching model ID. When multiple are set, priority is xAI > OpenRouter > OpenAI.
OPENROUTER_API_KEY=
# Required with OPENROUTER_API_KEY: choose an available ID at https://openrouter.ai/models
OPENROUTER_MODEL=

OPENAI_API_KEY=
OPENAI_MODEL=
XAI_API_KEY=
XAI_MODEL=

# Optional. Raises the GitHub REST API rate limit.
GITHUB_TOKEN=

# Optional shared 24-hour cache. Leave both empty to run without Redis.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Existing Vercel KV integrations may keep KV_REST_API_URL and KV_REST_API_TOKEN instead.
